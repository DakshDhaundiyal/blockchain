# TrustHarvest Environment Configuration
# Copy this file to .env for local development and fill in placeholder values.
# NEVER commit .env, private keys, or real RPC URLs to version control.
# In production (Render Free), set these variables inside Render Dashboard -> Environment.

# --- Core Flask Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-char-hex-secret-key
FLASK_ENV=development
PRODUCTION=false

# Demo mode enables persona switcher, tamper simulator buttons, Demo Decode QR, and explorer.
# MUST be false in production.
DEMO_MODE=false

# Set false in production (Render Free disk is ephemeral; uses static produce presets in static/img/).
ALLOW_IMAGE_UPLOADS=false

# --- Public App URL (REQUIRED for QR codes; never use localhost in production) ---
# Production example: https://trustharvest.onrender.com
BASE_URL=http://127.0.0.1:5000

# --- Database ---
# Local development uses SQLite by default.
# Production uses Neon Free PostgreSQL (paste your Neon connection string here):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
DATABASE_URL=sqlite:///trustharvest.db

# --- Blockchain RPC & Network ---
# Local Ganache: http://127.0.0.1:7545 (CHAIN_ID=1337)
# Production Sepolia (Alchemy Free Tier ONLY, NEVER Mainnet):
# ETH_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/REPLACE_WITH_ALCHEMY_KEY
# CHAIN_ID=11155111
ETH_RPC_URL=http://127.0.0.1:7545
CHAIN_ID=1337

# --- Smart Contract Addresses ---
# Active TrustHarvestV2 contract address on your target network
CONTRACT_ADDRESS=
# Comma-separated list of previous V1/V2 contract addresses for read-only historical verification
HISTORICAL_CONTRACT_ADDRESSES=
# Set false in production after CONTRACT_ADDRESS is deployed cleanly
ALLOW_AUTO_DEPLOY=false

# --- Server-Side Role Signing Keys (Sepolia Testnet ONLY - NEVER Mainnet keys or real ETH) ---
# Leave blank locally to use unlocked Ganache accounts 0..3.
# On Render Free, configure these as secret Environment Variables with separate Sepolia test accounts:
DEPLOYER_PRIVATE_KEY=
FARMER_PRIVATE_KEY=
TRANSPORTER_PRIVATE_KEY=
RETAILER_PRIVATE_KEY=

# Optional comma-separated expected public wallet allowlists per role
EXPECTED_FARMER_SIGNERS=
EXPECTED_TRANSPORTER_SIGNERS=
EXPECTED_RETAILER_SIGNERS=

# --- Limits ---
MAX_CONTENT_LENGTH=5242880
