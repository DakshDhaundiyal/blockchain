# TrustHarvest Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Flask secret key for session signing (REQUIRED in production)
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# Flask environment (development / production)
FLASK_ENV=development

# Database URI (default: SQLite)
# DATABASE_URI=sqlite:///trustharvest.db

# Ganache RPC URL for local blockchain
GANACHE_URL=http://127.0.0.1:7545

# Base URL for QR code verification links
BASE_URL=http://localhost:5000

# Maximum upload file size in bytes (default: 5MB)
MAX_CONTENT_LENGTH=5242880
